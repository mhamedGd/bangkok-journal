{
  "version": 8,
  "name": "Bangkok in Black & White",
  "metadata": {
    "description": "Monochrome Bangkok city map. Rail geometry and line colors from OTP Namtang GTFS. Outside-city features are masked."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "rail-routes": {
      "type": "geojson",
      "data": "./data/bangkok-rail.geojson"
    },
    "rail-stations": {
      "type": "geojson",
      "data": "./data/bangkok-stations.geojson"
    },
    "city-mask": {
      "type": "geojson",
      "data": "./data/bangkok-mask.geojson"
    },
    "city-boundary": {
      "type": "geojson",
      "data": "./data/bangkok-boundary.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#161616"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "park"
      ],
      "paint": {
        "fill-color": "#1c1c1c",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ],
      "paint": {
        "fill-color": "#1b1b1b",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#080808"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#080808",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          7
        ]
      }
    },
    {
      "id": "minor-streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "minor",
          "service",
          "tertiary"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#272727",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          18,
          3
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "main-streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "motorway",
          "trunk",
          "primary",
          "secondary"
        ],
        true,
        false
      ],
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#343434",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.5,
          13,
          1.2,
          17,
          5
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "national-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "class"
          ],
          "rail"
        ],
        [
          "!",
          [
            "has",
            "service"
          ]
        ]
      ],
      "paint": {
        "line-color": "#737373",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.7,
          14,
          1.4,
          18,
          2
        ],
        "line-dasharray": [
          3,
          2
        ],
        "line-opacity": 0.65
      }
    },
    {
      "id": "rail-casing",
      "type": "line",
      "source": "rail-routes",
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#b0b0b0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          2.5,
          12,
          4.5,
          16,
          7
        ],
        "line-opacity": 0.25
      }
    },
    {
      "id": "rail-lines",
      "type": "line",
      "source": "rail-routes",
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": [
          "get",
          "color"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.4,
          12,
          2.8,
          16,
          5
        ],
        "line-opacity": 1
      }
    },
    {
      "id": "rail-stations",
      "type": "circle",
      "source": "rail-stations",
      "minzoom": 12.5,
      "paint": {
        "circle-color": "#eeeeee",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12.5,
          2,
          17,
          4
        ],
        "circle-stroke-color": [
          "get",
          "color"
        ],
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "rail-station-labels",
      "type": "symbol",
      "source": "rail-stations",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-anchor": "left",
        "text-offset": [
          0.8,
          0
        ],
        "text-padding": 7
      },
      "paint": {
        "text-color": "#cccccc",
        "text-halo-color": "#111111",
        "text-halo-width": 2
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#777777",
        "text-halo-color": "#080808",
        "text-halo-width": 2
      }
    },
    {
      "id": "district-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "suburb",
          "town",
          "village"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.04,
        "text-padding": 25
      },
      "paint": {
        "text-color": "#919191",
        "text-halo-color": "#161616",
        "text-halo-width": 2
      }
    },
    {
      "id": "city-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "city"
        ],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          11,
          13,
          17
        ],
        "text-letter-spacing": 0.1,
        "text-padding": 35
      },
      "paint": {
        "text-color": "#c2c2c2",
        "text-halo-color": "#161616",
        "text-halo-width": 2
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 16,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#888888",
        "text-halo-color": "#161616",
        "text-halo-width": 2
      }
    },
    {
      "id": "outside-bangkok",
      "type": "fill",
      "source": "city-mask",
      "paint": {
        "fill-color": "#050505",
        "fill-opacity": 1,
        "fill-antialias": false
      }
    },
    {
      "id": "bangkok-outline",
      "type": "line",
      "source": "city-boundary",
      "paint": {
        "line-color": "#6b6b6b",
        "line-width": 1,
        "line-opacity": 0.7
      }
    }
  ]
}
